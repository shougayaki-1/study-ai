# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Large study-record photos temporarily transferred to this Mac (for example via AirDrop)
/record-images/
!/record-images/
!/record-images/.gitkeep

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# analysis (Claude Code batch, service role key)
analysis/.env
analysis/tmp/
analysis/menubar-app/node_modules/
analysis/menubar-app/dist/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
