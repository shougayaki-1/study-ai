NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push (VAPID)。生成方法は README を参照。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Vercel Cron から呼ばれる /api/cron/morning の認証用シークレット(任意の文字列)
CRON_SECRET=

# Supabase Service Role Key(/api配下のPush購読保存・Cron送信でRLSを越えて読み書きするために使用)
# Supabaseダッシュボード > Settings > API から取得。Vercel環境変数にのみ設定し、公開しないこと。
SUPABASE_SERVICE_ROLE_KEY=
