{
  "name": "study-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:analysis": "node --test analysis/menubar-app/test/*.test.js analysis/test/*.test.mjs",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "types:generate": "supabase gen types typescript --local --schema public | sed '/^Connecting to db /d' | perl -0pe 's/\\n+\\z/\\n/' > src/lib/supabase/types.ts",
    "types:check": "supabase gen types typescript --local --schema public | sed '/^Connecting to db /d' | perl -0pe 's/\\n+\\z/\\n/' > /tmp/study-ai-database.types.ts && diff -u src/lib/supabase/types.ts /tmp/study-ai-database.types.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.5",
    "@types/web-push": "^3.6.4",
    "next": "^15.5.20",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9",
    "eslint-config-next": "^15.5.20",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
